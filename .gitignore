.vscode/* 
idea/

# GitHub는 파일 하나당 100MB가 넘으면 push를 거부함
# 모델 파일은 구글 드라이브 등에 두고 README에 링크만 남기기
*.pt
*.pth
*.ckpt
*.h5
*.onnx
*.safetensors


# 윈도우: 폴더 썸네일 캐시, 폴더 표시 설정
Thumbs.db
desktop.ini
# 맥: 폴더 표시 정보
.DS_Store


__pycache__/
*.py[cod]
# 패키지를 만들 때 생기는 결과물
*.egg-info/
build/
dist/
 
 
# ---------- 2. 가상환경 ----------
# 라이브러리가 통째로 설치된 폴더라 수백 MB가 넘기도 함
# 대신 requirements.txt 로 "어떤 라이브러리가 필요한지"만 올리기
venv/
.venv/
env/
 
 
# ---------- 3. 주피터 노트북 ----------
# 노트북 자동 저장 백업본
.ipynb_checkpoints/
 
 
# ---------- 4. 비밀 정보 (가장 중요!) ----------
# API 키, 비밀번호 등을 적어두는 파일. 한 번 올라가면 기록에 남음
.env
.env.*
# 예외: 어떤 키가 필요한지 보여주는 예시 파일은 올려도 됨 (값은 비워두기)
!.env.example