# =====================================================================
# port-ai (항만 문제해결 AI 공모전) 용 .gitignore
# 원칙: "내가 직접 쓴 코드·설명서"만 올리고,
#       "대회 데이터 / 실행하면 다시 생기는 것 / 내 컴퓨터 전용 파일"은 올리지 않는다.
# =====================================================================


# ---------------------------------------------------------------------
# 1. 대회 원본 데이터 (가장 중요!)
#    데이콘 데이터는 대회 규칙상 외부 재배포가 금지되는 경우가 많고,
#    vessel_catalog.csv 같은 파일은 용량도 커서 깃허브에 올리면 안 된다.
# ---------------------------------------------------------------------
open/
*.csv
*.parquet
*.feather
*.xlsx

# 단, 내가 직접 만든 아주 작은 예시 CSV를 올리고 싶다면
# 아래처럼 "!"로 예외를 둘 수 있다 (앞의 규칙을 뒤집는 기호).
# !samples/tiny_example.csv


# ---------------------------------------------------------------------
# 2. 실행 결과물 — 코드만 있으면 언제든 다시 만들 수 있는 것들
# ---------------------------------------------------------------------
outputs/*          # outputs/v1, v2 ... 학습 결과·예측 파일
logs/*             # 학습 로그

# 학습된 모델 파일 (용량이 크고, 다시 학습하면 생김)
*.pkl
*.joblib
*.txt.model
*.lgb
*.bin
*.pt
*.pth

# 제출용 zip과 그 안의 model/ 폴더
*.zip
submit/*


# ---------------------------------------------------------------------
# 3. 파이썬 가상환경 / 캐시
#    가상환경은 "설명서(env/requirements-py311.txt)"만 있으면 다시 만들 수 있으므로
#    가상환경 폴더 자체는 올리지 않는다.
# ---------------------------------------------------------------------
py311/
.venv/
venv/
env/*/            # env/ 폴더 안에 실수로 가상환경을 만든 경우 대비 (env/의 파일들은 그대로 올라감)

__pycache__/      # 파이썬이 자동으로 만드는 컴파일 캐시
*.py[cod]
.pytest_cache/


# ---------------------------------------------------------------------
# 4. 주피터 노트북 관련
# ---------------------------------------------------------------------
.ipynb_checkpoints/   # 노트북 자동 저장본


# ---------------------------------------------------------------------
# 5. 에디터 / 운영체제 / 구글 드라이브가 만드는 파일
# ---------------------------------------------------------------------
.vscode/          # VS Code 개인 설정 (공유하고 싶으면 이 줄을 지우면 됨)
desktop.ini       # Windows·구글 드라이브가 폴더마다 만드는 파일
Thumbs.db         # Windows 썸네일 캐시
.DS_Store         # macOS 폴더 정보
*.tmp
~$*               # 엑셀 등을 열어둘 때 생기는 임시 파일


# ---------------------------------------------------------------------
# 6. 비밀 정보 (혹시 모를 대비)
# ---------------------------------------------------------------------
.env
*.key
kaggle.json